authserver __OCSERV_RADIUS_HOST__:__OCSERV_RADIUS_AUTH_PORT__
acctserver __OCSERV_RADIUS_HOST__:__OCSERV_RADIUS_ACCT_PORT__
nas-identifier __OCSERV_NAS_IDENTIFIER__
servers /etc/radiusclient/servers
dictionary /etc/radiusclient/dictionary
radius_timeout 10
radius_retries 3
radius_deadtime 0
login_tries 4
login_timeout 60
seqfile /var/run/radcli-seq
mapfile /etc/radiusclient/port-id-map
login_radius /bin/true
nologin /etc/nologin
issue /etc/radiusclient/issue
